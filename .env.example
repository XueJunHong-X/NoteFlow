# NoteFlow 环境变量模板
#
# 用法：复制为 .env 并填入自己的 Key。
#   copy .env.example .env
#
# 注意：.env 已被 .gitignore 排除，永远不要把它提交到仓库或打进发布包。

# 多模态模型 API Key（真实识别必填；没有它只能用离线示例）
NOTEFLOW_API_KEY=

# OpenAI 兼容接口地址
NOTEFLOW_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名（需支持图片输入的多模态模型）
NOTEFLOW_MODEL=qwen3-vl-plus

# 监听目录 / 输出目录 / vault 目录（桌面版以界面设置为准，这里只对命令行生效）
# NOTEFLOW_WATCH_DIR=./inbox
# NOTEFLOW_OUTPUT_DIR=./output
# NOTEFLOW_VAULT_DIR=./vault

# 识别并发数：1 / 2 / 4，命中限流会自动降到 1
# NOTEFLOW_CONCURRENCY=2

# 单次请求超时（秒）与重试次数
# NOTEFLOW_TIMEOUT=60
# NOTEFLOW_MAX_RETRIES=2

# 归档与关联
# NOTEFLOW_VAULT_LAYOUT={course}
# NOTEFLOW_MINDMAP_MODE=inline
# NOTEFLOW_MOC=on
# NOTEFLOW_LINKS=on
# NOTEFLOW_LINK_MIN_SCORE=3
# NOTEFLOW_LINK_MAX_PER_NOTE=4
# NOTEFLOW_LINK_MIN_NOTES=3
